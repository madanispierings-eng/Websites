# Public site URL, used for canonical URLs, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). Without these the public catalogue still works from the
# built-in course list, and accounts and practice show a clear "not configured" state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
